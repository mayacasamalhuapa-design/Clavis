<html data-type="html" data-identifier="713507e3-23aa-42cf-8f43-8cab6d00c9d1" data-title="Clavis — Plan de Negocios | Sitio Elegante" data-version="1" width="1200" height="900"><head>
<meta charset="utf-8">
<style>
  :root{
    --lila:#F4DAF6;
    --malva:#BC92C0;
    --violeta:#5D5B9B;
    --indigo:#333769;
    --tinta:#0D0D38;
    --papel:#FDFBFD;
    --blanco:#FFFFFF;
    --linea:rgba(188,146,192,.34);
    --linea-suave:rgba(93,91,155,.14);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    font-family:'Inter','Segoe UI',-apple-system,'Helvetica Neue',Arial,sans-serif;
    background:var(--papel);
    color:var(--tinta);
    -webkit-font-smoothing:antialiased;
    line-height:1.62;
    font-size:15px;
  }

  /* ============ PANEL SUPERIOR ============ */
  #top-panel{
    position:sticky;top:0;z-index:100;
    background:rgba(253,251,253,.94);
    backdrop-filter:saturate(180%) blur(14px);
    border-bottom:1px solid var(--linea);
  }
  .bar{
    max-width:1120px;margin:0 auto;padding:20px 32px 16px;
    display:flex;align-items:center;justify-content:space-between;gap:24px;
  }
  .brand{display:flex;align-items:center;gap:14px;text-decoration:none}
  .brand svg{display:block}
  .brand-txt{display:flex;flex-direction:column;line-height:1.1}
  .brand-name{
    font-size:19px;font-weight:600;letter-spacing:.34em;color:var(--tinta);
  }
  .brand-tag{
    font-size:8.5px;font-weight:500;letter-spacing:.22em;text-transform:uppercase;
    color:var(--malva);margin-top:5px;
  }
  .bar-meta{
    text-align:right;font-size:9.5px;letter-spacing:.18em;text-transform:uppercase;
    color:var(--violeta);font-weight:500;
  }
  .bar-meta span{display:block;color:var(--malva);margin-top:4px;letter-spacing:.14em}

  nav.sections{
    max-width:1120px;margin:0 auto;padding:0 32px;
    display:flex;align-items:stretch;gap:2px;
  }
  .nav-item{position:relative}
  .nav-item > a{
    display:block;padding:11px 13px 13px;
    font-size:10.5px;font-weight:600;letter-spacing:.13em;text-transform:uppercase;
    color:var(--indigo);text-decoration:none;
    border-bottom:2px solid transparent;transition:.22s;white-space:nowrap;
  }
  .nav-item > a .idx{color:var(--malva);margin-right:6px;font-weight:500}
  .nav-item:hover > a{color:var(--violeta);border-bottom-color:var(--malva)}
  .nav-item > a.active{color:var(--tinta);border-bottom-color:var(--violeta)}
  .dropdown{
    position:absolute;top:100%;left:0;min-width:250px;
    background:var(--blanco);
    border:1px solid var(--linea);
    box-shadow:0 18px 44px -18px rgba(13,13,56,.28);
    padding:9px 0;list-style:none;
    opacity:0;visibility:hidden;transform:translateY(-5px);
    transition:.2s;
  }
  .nav-item:hover .dropdown{opacity:1;visibility:visible;transform:translateY(0)}
  .dropdown a{
    display:block;padding:8px 20px;font-size:12px;color:var(--indigo);
    text-decoration:none;transition:.16s;border-left:2px solid transparent;
  }
  .dropdown a:hover{background:rgba(244,218,246,.5);color:var(--tinta);border-left-color:var(--malva)}
  .dropdown a i{font-style:normal;color:var(--malva);margin-right:8px;font-size:10px}
  #progress{height:2px;background:var(--violeta);width:0%;transition:width .1s linear}

  /* ============ CONTENIDO ============ */
  main{max-width:1120px;margin:0 auto;padding:0 32px}
  section{padding:78px 0 20px;scroll-margin-top:150px;border-bottom:1px solid var(--linea-suave)}
  section:last-of-type{border-bottom:none}
  .eyebrow{
    font-size:9.5px;font-weight:600;letter-spacing:.26em;text-transform:uppercase;
    color:var(--malva);margin-bottom:16px;
  }
  h1{
    font-size:52px;font-weight:300;letter-spacing:-.028em;line-height:1.06;
    color:var(--tinta);margin-bottom:20px;
  }
  h1 em{font-style:normal;color:var(--violeta)}
  h2{
    font-size:31px;font-weight:400;letter-spacing:-.022em;line-height:1.18;
    color:var(--tinta);margin-bottom:12px;
  }
  h2 .num{
    display:block;font-size:10px;font-weight:600;letter-spacing:.26em;
    color:var(--malva);margin-bottom:11px;
  }
  h3{
    font-size:15px;font-weight:600;letter-spacing:.01em;color:var(--indigo);
    margin:40px 0 12px;scroll-margin-top:155px;
    padding-bottom:9px;border-bottom:1px solid var(--linea);
  }
  h3 b{color:var(--malva);font-weight:600;margin-right:9px}
  h4{font-size:12.5px;font-weight:600;letter-spacing:.09em;text-transform:uppercase;color:var(--violeta);margin:26px 0 9px}
  p{margin-bottom:14px;color:rgba(13,13,56,.86);max-width:76ch}
  .lead{font-size:18px;font-weight:300;line-height:1.62;color:var(--indigo);max-width:70ch}
  ul.clean{list-style:none;margin:6px 0 18px}
  ul.clean li{padding:6px 0 6px 20px;position:relative;color:rgba(13,13,56,.86);max-width:76ch}
  ul.clean li::before{content:'';position:absolute;left:0;top:15px;width:7px;height:1px;background:var(--malva)}
  strong{font-weight:600;color:var(--tinta)}

  /* quote / cita de clase */
  .quote{
    border-left:2px solid var(--malva);
    padding:4px 0 4px 22px;margin:22px 0 30px;
    font-size:15px;font-style:italic;font-weight:300;color:var(--violeta);max-width:74ch;
  }

  /* tablas */
  .tw{overflow-x:auto;margin:20px 0 26px}
  table{width:100%;border-collapse:collapse;font-size:13.5px}
  th{
    text-align:left;padding:10px 14px 10px 0;
    font-size:9.5px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
    color:var(--violeta);border-bottom:1px solid var(--violeta);white-space:nowrap;
  }
  td{padding:11px 14px 11px 0;border-bottom:1px solid var(--linea-suave);vertical-align:top;color:rgba(13,13,56,.86)}
  tr:last-child td{border-bottom:none}
  td.n,th.n{text-align:right;font-variant-numeric:tabular-nums;padding-right:0}
  tr.tot td{border-top:1px solid var(--malva);border-bottom:none;font-weight:600;color:var(--tinta)}
  tr.hi td{background:rgba(244,218,246,.42);font-weight:600;color:var(--tinta);padding-left:14px}
  .win{color:var(--violeta);font-weight:600}
  .win::before{content:'●';font-size:8px;margin-right:7px;vertical-align:1px}

  /* cifras */
  .figs{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--linea);margin:28px 0 6px;border:1px solid var(--linea)}
  .fig{background:var(--blanco);padding:26px 24px}
  .fig .lab{font-size:9px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--malva);margin-bottom:12px}
  .fig .val{font-size:30px;font-weight:300;letter-spacing:-.03em;color:var(--tinta);font-variant-numeric:tabular-nums}
  .fig .sub{font-size:11px;color:var(--violeta);margin-top:7px;letter-spacing:.02em}
  .fig.accent{background:linear-gradient(160deg,#F4DAF6 0%,#FBF2FC 100%)}
  .fig.accent .val{color:var(--tinta)}
  .fig.dark{background:var(--tinta)}
  .fig.dark .lab{color:var(--malva)}
  .fig.dark .val{color:#fff}
  .fig.dark .sub{color:rgba(244,218,246,.8)}

  /* dos columnas */
  .duo{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--linea);border:1px solid var(--linea);margin:24px 0 26px}
  .duo>div{background:var(--blanco);padding:28px 26px}
  .duo h4{margin-top:0}
  .duo p{font-size:13.5px;margin-bottom:0}
  .badge{
    display:inline-block;margin-top:16px;padding:5px 11px;
    background:var(--tinta);color:var(--lila);
    font-size:9px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;
  }
  .badge.g{background:rgba(244,218,246,.7);color:var(--indigo)}

  /* caja aviso */
  .note{
    background:var(--blanco);border:1px solid var(--linea);
    border-left:2px solid var(--violeta);
    padding:22px 26px;margin:26px 0;
  }
  .note h4{margin-top:0}
  .note p{margin-bottom:0;font-size:13.5px}

  /* pasos */
  ol.steps{list-style:none;counter-reset:s;margin:18px 0 24px}
  ol.steps li{
    counter-increment:s;position:relative;padding:12px 0 12px 46px;
    border-bottom:1px solid var(--linea-suave);font-size:13.5px;color:rgba(13,13,56,.86);
  }
  ol.steps li::before{
    content:counter(s,decimal-leading-zero);position:absolute;left:0;top:12px;
    font-size:10px;font-weight:600;letter-spacing:.1em;color:var(--malva);
  }

  footer{
    border-top:1px solid var(--linea);margin-top:60px;
    background:var(--tinta);color:rgba(244,218,246,.72);
  }
  .fin{max-width:1120px;margin:0 auto;padding:46px 32px;display:flex;justify-content:space-between;align-items:flex-end;gap:30px;flex-wrap:wrap}
  .fin p{color:rgba(244,218,246,.68);font-size:11.5px;margin:0;max-width:56ch;letter-spacing:.02em}
  .fin .mk{font-size:9.5px;letter-spacing:.24em;text-transform:uppercase;color:var(--malva)}
  .refs{font-size:11.5px;color:rgba(13,13,56,.7)}
  .refs div{padding:7px 0;border-bottom:1px solid var(--linea-suave);max-width:88ch}
</style>
</head>
